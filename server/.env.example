# Configure on the server only. Never put these values in the APK or Git.
AMAZON_RVS_SHARED_SECRET=
# LAT accepts only betaProduct=true. PRODUCTION rejects beta/test receipts.
FLORATEND_RVS_ENVIRONMENT=LAT
# Generate at least 32 random characters, separately from Amazon's shared secret.
FLORATEND_RATE_SALT=
# Upload server secrets through Cloudflare secret storage using a private JSON file.
